# Copy this file to deployment.env and replace every placeholder.
# Subscription and tenant IDs are identifiers, not secrets, but deployment.env
# is ignored so each developer can keep their own Azure context locally.

AZURE_ENV_NAME=clinical-trial-demo
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_LOCATION=eastus2
# Optional: your user object ID for local-development data-plane roles.
AZURE_PRINCIPAL_ID=
BUDGET_CONTACT_EMAIL=you@example.com
